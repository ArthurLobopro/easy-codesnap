{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "es2020",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/webview/*"
      ],
      "@hooks/*": [
        "src/webview/ui/react/hooks/*"
      ],
      "@assets/*": [
        "src/webview/assets/*"
      ],
      "@codicons/*": [
        "node_modules/@vscode/codicons/src/icons/*"
      ]
    }
  },
  "include": [
    "src/webview/**/*.ts",
    "src/webview/**/*.tsx",
    "src/types.d.ts"
  ]
}